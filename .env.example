# App's own read-write operational store (groups, delivery runs, team
# assignments, job overrides). Also editable from the app's Connection
# settings dialog, which takes precedence over this file at runtime.
PG_PROXY_URL=https://pg-proxy-production.up.railway.app/api/sql
PG_PROXY_DATABASE=replace-with-ops-database-name
PG_PROXY_TOKEN=replace-with-full-access-bearer-token

# Read-only connection to the upstream business database (invoices,
# customers, payments) that the installation pipeline is built from.
PG_SOURCE_PROXY_URL=https://pg-proxy-production.up.railway.app/api/sql
PG_SOURCE_PROXY_DATABASE=replace-with-source-database-name
PG_SOURCE_PROXY_TOKEN=replace-with-read-only-bearer-token
